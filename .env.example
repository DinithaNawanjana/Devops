# ─── Backend ──────────────────────────────────────────────
# JWT signing secret — CHANGE THIS in any real deployment
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=1440

# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_DB=devops_platform
# DSN used by the backend (host is the compose service name)
DATABASE_URL=postgresql+asyncpg://devops:devops@db:5432/devops_platform

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Lab engine ───────────────────────────────────────────
# Idle timeout & hard cap (minutes) for sandbox containers
LAB_IDLE_TIMEOUT_MIN=30
LAB_MAX_DURATION_MIN=120
# Per-container resource caps
LAB_MEMORY_LIMIT=512m
LAB_CPU_LIMIT=1.0
# Docker network lab containers attach to
LAB_NETWORK=devops_labnet

# ─── Frontend ─────────────────────────────────────────────
# Browser-facing base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
